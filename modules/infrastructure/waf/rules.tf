
# Creating the Rule Group which will be applied on AWS Web ACL
resource "aws_wafv2_rule_group" "block_bad_actors" {
  name        = "block_bad_actors_${var.environment}"
  description = "Blocks IP per DEVOPS-7312"
  scope       = "REGIONAL"
  capacity    = 25
  rule {
    name     = "block_bad_actors_${var.environment}"
    priority = 1

    action {
      block {}
    }

    statement {
      ip_set_reference_statement {
        arn = aws_wafv2_ip_set.blocked_ips.arn
      }
    }
    visibility_config {
      cloudwatch_metrics_enabled = true
      metric_name                = "block_bad_actors_rule_${var.environment}"
      sampled_requests_enabled   = true
    }
  }

  visibility_config {
    cloudwatch_metrics_enabled = true
    metric_name                = "block_bad_actors_${var.environment}"
    sampled_requests_enabled   = true
  }
}

